@page "/"
@inject NavigationManager navigateMgr;
@implements IDisposable
@inject ILogger<NavigationManager> Logger

<PageTitle>Home</PageTitle>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
	<MudGrid>
		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="2" Class="pa-1">
				<MudCardHeader>
					<CardHeaderContent>
						<MudText Typo="Typo.h3">@incomeTotal $</MudText>
					</CardHeaderContent>
					<CardHeaderActions>
						<MudIconButton Icon="@Icons.Material.Filled.ArrowCircleRight" Size="@Size.Large" Color="Color.Default"
									   @onclick="NavigateToIncomeComponent" />
					</CardHeaderActions>
				</MudCardHeader>
				<MudCardContent class="card-value">
					Income
				</MudCardContent>
			</MudCard>
		</MudItem>
		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="2" Class="pa-1">
				<MudCardHeader>
					<CardHeaderContent>
						<MudText Typo="Typo.h3">@expensesTotal $</MudText>
					</CardHeaderContent>
					<CardHeaderActions>
						<MudIconButton Icon="@Icons.Material.Filled.ArrowCircleRight" Size="@Size.Large" Color="Color.Default"
									   @onclick="NavigateToExpenseComponent" />
					</CardHeaderActions>
				</MudCardHeader>
				<MudCardContent class="card-value">
					Expenses
				</MudCardContent>
			</MudCard>
		</MudItem>
		<MudItem xs="12" sm="12" md="4">
			<MudCard Elevation="2" Class="pa-1">
				<MudCardHeader>
					<CardHeaderContent>
						<MudText Typo="Typo.h3">@savingsTotal $</MudText>
					</CardHeaderContent>
					<CardHeaderActions>
						<MudIconButton Icon="@Icons.Material.Filled.Analytics" Size="@Size.Large" Color="Color.Default" />
					</CardHeaderActions>
				</MudCardHeader>
				<MudCardContent class="card-value">
					Savings
				</MudCardContent>
			</MudCard>
		</MudItem>
		<MudItem xs="12" sm="6">
			<MudPaper Elevation="2" Class="pa-4 object-center" Style="height: 100%;align-content:center">
				<MudChart ChartType="ChartType.Donut" Width="300px" Height="300px" InputData="@data" InputLabels="@labels">
					<CustomGraphics>
						<text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="16">Expences by Category</text>
						<text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="50">@data.Sum().ToString()</text>
					</CustomGraphics>
				</MudChart>
			</MudPaper>
		</MudItem>
		<MudItem xs="12" sm="6">
			<MudPaper Elevation="2" Class="pa-4 object-center" Style="height: 100%;align-content:center">
				<MudChart ChartType="ChartType.Donut" Width="300px" Height="300px" InputData="@data" InputLabels="@labels">
					<CustomGraphics>
						<text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="16">Income Breakdown</text>
						<text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="50">@data.Sum().ToString()</text>
					</CustomGraphics>
				</MudChart>
			</MudPaper>
			@code {
				public double[] data = { 25, 77, 28, 5 };
				public string[] labels = { "Oil", "Coal", "Gas", "Biomass" };
			}
		</MudItem>
	</MudGrid>
</MudContainer>

<style>
	.card-value {
		font-size: 16px;
		font-family: Arial;
	}

</style>

@code {
	bool _drawerOpen = true;
	int expensesTotal = 6790;
	int incomeTotal = 3600;
	int savingsTotal = 2900;


	private void NavigateToIncomeComponent() => navigateMgr.NavigateTo("income");
	private void NavigateToExpenseComponent() => navigateMgr.NavigateTo("expenses");

	protected override void OnInitialized() =>
		navigateMgr.LocationChanged += HandleLocationChanged;

	private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) =>
		Logger.LogInformation("URL of new location: {Location}", e.Location);

	public void Dispose() => navigateMgr.LocationChanged -= HandleLocationChanged;
}