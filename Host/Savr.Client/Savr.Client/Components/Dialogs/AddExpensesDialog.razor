@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using Savr.Client.Data.Models
@using Savr.Client.Services
@using Savr.Client.Services.Interafces
@inject ISnackbar SnackBar

<MudDialog DisableSidePadding="true">
	<DialogContent>
		<MudContainer MaxWidth="MaxWidth.Medium" Width="100%" Class="pa-4">
			<MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
				<MudSelect T="string" Label="Expense Type" @bind-Value="expense.ExpenseType" Required="true" RequiredError="Expense type required">
					<MudSelectItem Value="@("Credit Card Payment")" />
					<MudSelectItem Value="@("Grocery")" />
					<MudSelectItem Value="@("Traveling")" />
					<MudSelectItem Value="@("Bill Payment")" />
					<MudSelectItem Value="@("Insurance")" />
					<MudSelectItem Value="@("Medical")" />
				</MudSelect>
				<MudNumericField T="decimal" Label="Amount" @bind-Value="expense.Amount" Required="true" RequiredError="Amount is required!" />
				<MudDatePicker Label="Date" @bind-Date="currentDate" />
				<MudTextField T="string" Label="Reference" @bind-Value="expense.Reference" Required="true" RequiredError="Reference required" />
			</MudForm>
		</MudContainer>
	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" OnClick="Cancel">Cancel</MudButton>
		<MudButton Variant="Variant.Filled" C Color="Color.Primary" OnClick="Submit" Disabled="@(!success)">Save</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[Inject]
	private IDialogService DialogService { get; set; } // for MessageBox

	[CascadingParameter]
	private IMudDialogInstance MudDialog { get; set; }

	[Inject]
	public IExpenseService ExpenseService { get; set; }

	private DateTime? currentDate = DateTime.Today;

	public Expense expense = new Expense()
	{
		Amount = 0,
		ExpenseType = string.Empty,
		Reference = string.Empty,
		Date = DateTime.Today,
	};

	bool success;
	string[] errors = { };
	MudForm form;

	private async Task Submit()
	{
		var expenseResponse = await ExpenseService.CreateExpense(expense);

		if (expenseResponse != null)
		{
			SnackBar.Add("Record added Successfully!", Severity.Success);
		}

		MudDialog.Close(DialogResult.Ok(string.Empty));
	}

	private void Cancel() => MudDialog.Cancel();
}