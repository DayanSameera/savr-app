@page "/expenses"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Savr.Client.Components.Dialogs
@using Savr.Client.Services.Interafces
@inject NavigationManager navigateMgr;
@inject IDialogService DialogService

<PageTitle>Expenses</PageTitle>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
	<MudIconButton Icon="@Icons.Material.Filled.ArrowCircleLeft" Size="@Size.Large" Color="Color.Default" @onclick="NavigateToHomeComponent" />

	<MudButton @onclick="OpenDialogAsync" Variant="Variant.Filled" Color="Color.Primary">
		Add New
	</MudButton>

	<h2>Expenses</h2>
	<MudDataGrid Items="@expenseList" Filterable="true" SortMode="@SortMode.None" Groupable="false" Hover="true" HeaderClass="mud-secondary">
		<Columns>
			<PropertyColumn Property="x => x.Reference" Title="Reference" />
			<PropertyColumn Property="x => x.ExpenseType" Title="Expense Type" />
			<PropertyColumn Property="x => x.Amount" Format="C" Title="Amount" />
			<PropertyColumn Property="x => x.Date" Format="dd/MM/yy" />
			<TemplateColumn CellClass="d-flex justify-end">
				<CellTemplate>
					<MudStack Row>
						<MudButton Size="@Size.Small" Variant="@Variant.Outlined" Color="@Color.Primary">Edit</MudButton>
						<MudButton Size="@Size.Small" Variant="@Variant.Outlined" Color="@Color.Primary">DElete</MudButton>
					</MudStack>
				</CellTemplate>
			</TemplateColumn>
		</Columns>
	</MudDataGrid>
</MudContainer>

@code {
	public IEnumerable<Savr.Client.Data.Models.Expense> expenseList;

	[Inject]
	public IExpenseService ExpenseService { get; set; }

	protected override async Task OnInitializedAsync()
	{
		expenseList = await ExpenseService.GetExpenses();
	}

	private async Task OpenDialogAsync()
	{
		var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true };
		var dialogReference = await DialogService.ShowAsync<AddExpensesDialog>("Add Expense", options);
		StateHasChanged();
		var dialogResult = await dialogReference.Result;
		if (dialogResult.Canceled)
		{
			StateHasChanged();
		}
		else
		{
			var data = dialogResult.Data;
			expenseList = await ExpenseService.GetExpenses();
			StateHasChanged();
		}
	}

	private void NavigateToHomeComponent() => navigateMgr.NavigateTo("/");
}
