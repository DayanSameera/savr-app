@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@using Savr.Client.Data.Models
@using Savr.Client.Services.Interafces
@inject ISnackbar SnackBar

<MudDialog DisableSidePadding="true">
	<DialogContent>
		<MudContainer MaxWidth="MaxWidth.Medium" Width="100%" Class="pa-4">
			<MudForm @ref="form" @bind-IsValid="@success" @bind-Errors="@errors">
				<MudTextField T="string" Label="Name" Required="true" RequiredError="Name required" @bind-Value="income.SourceName" />
				<MudNumericField T="decimal" Label="Amount" Required="true" RequiredError="Amount is required!" @bind-Value="income.Amount" />
				<MudSelect T="string" Label="Income Category" @bind-Value="income.IncomeCategory" Required="true" RequiredError="Income category required">
					<MudSelectItem Value="@("Salary")" />
					<MudSelectItem Value="@("Gift")" />
					<MudSelectItem Value="@("Commission")" />
					<MudSelectItem Value="@("Profit Income")" />
					<MudSelectItem Value="@("Fixed Deposit Income")" />
				</MudSelect>
				<MudDatePicker Label="Date" @bind-Date="currentDate" />
				<MudTextField T="string" Label="Notes" @bind-Value="income.Note" />
			</MudForm>
		</MudContainer>
	</DialogContent>
	<DialogActions>
		<MudButton Color="Color.Primary" OnClick="Cancel">Cancel</MudButton>
		<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="@(!success)">Save</MudButton>
	</DialogActions>
</MudDialog>

@code {
	[Inject]
	private IDialogService DialogService { get; set; } // for MessageBox

	[CascadingParameter]
	private IMudDialogInstance MudDialog { get; set; }

	[Inject]
	public IIncomeService IncomeService { get; set; }

	private DateTime? currentDate = DateTime.Today;

	public Income income = new Income()
	{
		IncomeId = string.Empty,
		Amount = 0,
		SourceName = string.Empty,
		IncomeCategory = string.Empty,
		Date = DateTime.Today,
		Note = string.Empty
	};

	bool success;
	string[] errors = { };
	MudForm form;

	private async Task Submit()
	{
		var incomeList = await IncomeService.CreateIncome(income);

		if (incomeList != null)
		{
			SnackBar.Add("Record added Successfully!", Severity.Success);
		}

		MudDialog.Close(DialogResult.Ok(string.Empty));
	}

	private void Cancel() => MudDialog.Cancel();

	protected override async Task OnInitializedAsync()
	{

	}
}