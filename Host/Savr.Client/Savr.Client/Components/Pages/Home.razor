@page "/"
@using Savr.Client.Services.Interafces
@using System.Globalization
@inject NavigationManager navigateMgr;
@implements IDisposable
@inject ILogger<NavigationManager> Logger

<PageTitle>Home</PageTitle>

<MudContainer Class="mt-16 px-8" MaxWidth="MaxWidth.False">
	<MudGrid>
		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="2" Class="pa-1 card-income">
				<MudCardHeader>
					<CardHeaderContent>
						<MudText Typo="Typo.h3" Style="color: mediumseagreen">@dashboardData.TotalIncome $</MudText>
					</CardHeaderContent>
					<CardHeaderActions>
						<MudIconButton Icon="@Icons.Material.Filled.ArrowCircleRight" Size="@Size.Large" Color="Color.Default"
									   @onclick="NavigateToIncomeComponent" />
					</CardHeaderActions>
				</MudCardHeader>
				<MudCardContent class="card-value">
					Income
				</MudCardContent>
			</MudCard>
		</MudItem>
		<MudItem xs="12" sm="6" md="4">
			<MudCard Elevation="2" Class="pa-1 card-expense">
				<MudCardHeader>
					<CardHeaderContent>
						<MudText Typo="Typo.h3" Style="color: deeppink" Format="F2">@dashboardData.TotalExpences $</MudText>
					</CardHeaderContent>
					<CardHeaderActions>
						<MudIconButton Icon="@Icons.Material.Filled.ArrowCircleRight" Size="@Size.Large" Color="Color.Default"
									   @onclick="NavigateToExpenseComponent" />
					</CardHeaderActions>
				</MudCardHeader>
				<MudCardContent class="card-value">
					Expenses
				</MudCardContent>
			</MudCard>
		</MudItem>
		<MudItem xs="12" sm="12" md="4">
			<MudCard Elevation="2" Class="pa-1 card-savings">
				<MudCardHeader>
					<CardHeaderContent>
						<MudText Typo="Typo.h3" Style="color: blueviolet"> @dashboardData.TotalSavings $</MudText>
					</CardHeaderContent>
					<CardHeaderActions>
						<MudIconButton Icon="@Icons.Material.Filled.Analytics" Size="@Size.Large" Color="Color.Default" />
					</CardHeaderActions>
				</MudCardHeader>
				<MudCardContent class="card-value">
					Savings
				</MudCardContent>
			</MudCard>
		</MudItem>
		<MudItem xs="12" sm="6">
			<MudPaper Elevation="2" Class="pa-4 object-center" Style="height: 100%;align-content:center">
				<MudChart ChartType="ChartType.Donut" Width="300px" Height="300px" InputData="@graphIncomedata" InputLabels="@graphIncomeLabels">
					<CustomGraphics>
						<text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="16">Income Breakdown</text>
						<text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="50">@graphIncomedata.Sum().ToString()</text>
					</CustomGraphics>
				</MudChart>
			</MudPaper>
		</MudItem>
		<MudItem xs="12" sm="6">
			<MudPaper Elevation="2" Class="pa-4 object-center" Style="height: 100%;align-content:center">
				<MudChart ChartType="ChartType.Donut" Width="300px" Height="300px" InputData="@graphExpensedata" InputLabels="@graphExpenseLabels">
					<CustomGraphics>
						<text class="donut-inner-text" x="50%" y="35%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="16">Expences by Category</text>
						<text class="donut-inner-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="black" font-family="Helvetica" font-size="50">@graphExpensedata.Sum().ToString()</text>
					</CustomGraphics>
				</MudChart>
			</MudPaper>
		</MudItem>
	</MudGrid>
</MudContainer>

<style>
	.card-value {
		font-size: 16px;
		font-family: Arial;
	}

	/* Add a colored left line */
	.card-income {
		border-bottom: 2px solid mediumseagreen; /* Blue color, adjust as needed */
		border-right: 0; /* Remove right border */
		border-top: 0; /* Remove top border */
		border-left: 0; /* Remove bottom border */
	}

	.card-expense {
		border-bottom: 2px solid deeppink; /* Blue color, adjust as needed */
		border-right: 0; /* Remove right border */
		border-top: 0; /* Remove top border */
		border-left: 0; /* Remove bottom border */
	}

	.card-savings {
		border-bottom: 2px solid blueviolet; /* Blue color, adjust as needed */
		border-right: 0; /* Remove right border */
		border-top: 0; /* Remove top border */
		border-left: 0; /* Remove bottom border */
	}

</style>

@code {
	public Savr.Client.Data.Models.Dashboard dashboardData = new Data.Models.Dashboard { TotalExpences = 0, TotalIncome = 0, TotalSavings = 0 };

	[Inject]
	public IDashboardService DashboardService { get; set; }

	bool _drawerOpen = true;
	public double[]? graphIncomedata = { };
	public string[]? graphIncomeLabels = { };
	public double[]? graphExpensedata = { };
	public string[]? graphExpenseLabels = { };

	private bool _editable = true;
	private bool _clearable = true;
	private DateRange _dateRange { get; set; }
	public CultureInfo _en = CultureInfo.GetCultureInfo("en-US");

	private void NavigateToIncomeComponent() => navigateMgr.NavigateTo("income");
	private void NavigateToExpenseComponent() => navigateMgr.NavigateTo("expenses");

	protected override async Task OnInitializedAsync()
	{
		dashboardData = await DashboardService.GetDashboardData();

		graphIncomedata = dashboardData.IncomeItems.Select(q => decimal.ToDouble(q.Sum)).ToArray();
		graphIncomeLabels = dashboardData.IncomeItems.Select(q => q.Category).ToArray();

		graphExpensedata = dashboardData.ExpenseItems.Select(q => decimal.ToDouble(q.Sum)).ToArray();
		graphExpenseLabels = dashboardData.ExpenseItems.Select(q => q.Category).ToArray();
	}

	protected override void OnInitialized() =>
		navigateMgr.LocationChanged += HandleLocationChanged;

	private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) =>
		Logger.LogInformation("URL of new location: {Location}", e.Location);

	public void Dispose() => navigateMgr.LocationChanged -= HandleLocationChanged;
}